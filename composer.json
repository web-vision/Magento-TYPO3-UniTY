{
    "name": "web-vision/wv_t3unity",
    "type": "typo3-cms-extension",
    "description": "TYPO3 part of the Unity extension pack. Adds Templates and classes for basic functionality.",
    "license": [
        "GPL-2.0+"
    ],
    "authors": [
        {
            "name": "web-vision GmbH",
            "email": "hello@web-vision.de"
        }
    ],
	"support": {
		"issues": "https://github.com/web-vision/Magento-TYPO3-UniTY/issues",
		"source": "https://github.com/web-vision/Magento-TYPO3-UniTY"
	},
	"homepage": "https://github.com/web-vision/Magento-TYPO3-UniTY",
	"extra": {
        "typo3/cms": {
            "extension-key": "wv_t3unity",
            "web-dir": ".Build/Web"
        }
    },
    "config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"allow-plugins": true,
        "sort-packages": true
	},
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "typo3/cms-backend": "^12.4",
        "typo3/cms-core": "^12.4",
        "typo3/cms-filelist": "^12.4",
        "typo3/cms-frontend": "^12.4",
        "typo3/cms-tstemplate": "^12.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.14",
        "helmich/typo3-typoscript-lint": "^3.3",
        "phpstan/phpstan": "^1.3",
        "saschaegerer/phpstan-typo3": "^1.8",
        "symfony/var-dumper": "^6.3",
        "typo3/cms-dashboard": "^12.4",
        "typo3/cms-extbase": "^12.4",
        "typo3/cms-extensionmanager": "^12.4",
        "typo3/cms-felogin": "^12.4",
        "typo3/cms-filemetadata": "^12.4",
        "typo3/cms-fluid": "^12.4",
        "typo3/cms-fluid-styled-content": "^12.4",
        "typo3/cms-form": "^12.4",
        "typo3/cms-indexed-search": "^12.4",
        "typo3/cms-info": "^12.4",
        "typo3/cms-install": "^12.4",
        "typo3/cms-linkvalidator": "^12.4",
        "typo3/cms-lowlevel": "^12.4",
        "typo3/cms-seo": "^12.4",
        "typo3/cms-setup": "^12.4",
        "typo3/coding-standards": "^0.5",
        "typo3/testing-framework": "^8.3.1"
    },
    "autoload": {
        "psr-4": {
            "WebVision\\WvT3unity\\": "Classes"
        }
    },
	"autoload-dev": {
		"psr-4": {
			"WebVision\\WvT3unity\\Tests\\": "Tests"
		}
	}
}
