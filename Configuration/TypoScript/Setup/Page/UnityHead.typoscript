// Header data mode maybe we should rename in to UnityHeadJson
UnityHead = PAGE
UnityHead {
    typeNum = 3210

    config {
        // set proper content type
        additionalHeaders {
            10 {
                header = Content-Type: application/json; charset=utf-8
                replace = 1
            }
        }

        admPanel = 0
        debug = 0

        disableAllHeaderCode = 1

        disableBodyTag = 1
        // write inline CSS/JS in file
        removeDefaultCss = external
        removeDefaultJS = external
    }

    10 = USER
    10 {
        userFunc = WebVision\WvT3unity\UserFunc\ContentJson->getPageData
    }
}
